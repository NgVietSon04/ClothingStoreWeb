@model ClothingStoreWeb.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công";
    Layout = "~/Views/User/Shared/LayoutUser.cshtml";
}

<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/LayoutUser/img/breadcrumb.jpg")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Đặt Hàng Thành Công</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <span>Thành công</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="mb-4">
                    <i class="fa fa-check-circle text-success" style="font-size: 64px;"></i>
                </div>
                <h3 class="font-weight-bold mb-3">Cảm ơn bạn đã đặt hàng!</h3>
                <p class="text-muted">Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.</p>
                @if (Model != null)
                {
                    <p class="font-weight-bold">Mã đơn hàng: #@Model.OrderId</p>
                }
                <div class="mt-4">
                    <a asp-controller="Shop" asp-action="Index" class="primary-btn mr-2">TIẾP TỤC MUA SẮM</a>
                    <a asp-controller="Order" asp-action="History" class="primary-btn cart-btn">XEM LỊCH SỬ ĐƠN HÀNG</a>
                </div>
            </div>
        </div>
    </div>
</section>