@model ClothingStoreWeb.Models.Cart

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    Layout = "~/Views/User/Shared/LayoutUser.cshtml";

    decimal GetFinalPrice(ProductVariant? v)
    {
        if (v == null) return 0;
        decimal price = (decimal)(v.UnitPrice ?? (double?)(v.Product?.MinPrice ?? 0m) ?? 0d);
        decimal percent = (decimal)(v.Discount ?? 0);
        return percent > 0 ? Math.Round(price * (1 - percent / 100m), 0) : price;
    }

    decimal subTotal = 0;
    if (Model?.CartDetails != null)
    {
        subTotal = Model.CartDetails.Sum(cd => cd.Quantity * GetFinalPrice(cd.Variant));
    }
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/LayoutUser/img/breadcrumb.jpg")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Giỏ hàng</h2>
                    <div class="breadcrumb__option">
                        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                        <span>Giỏ hàng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Shopping Cart Section Begin -->
<section class="shoping-cart spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="shoping__cart__table">
                    <table>
                        <thead>
                            <tr>
                                <th class="shoping__product">Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cart-items-body">
                            @if (Model?.CartDetails != null && Model.CartDetails.Any())
                            {
                                foreach (var item in Model.CartDetails)
                                {
                                    var productName = item.Variant?.Product?.ProductName ?? "Sản phẩm";

                                    // Lấy đúng ảnh của biến thể hoặc sản phẩm
                                    var imageFileName = !string.IsNullOrEmpty(item.Variant?.Thumbnail)
                                    ? item.Variant.Thumbnail
                                    : (!string.IsNullOrEmpty(item.Variant?.Product?.Thumbnail) ? item.Variant.Product.Thumbnail : "product-1.jpg");

                                    imageFileName = imageFileName.Trim();

                                    var imagePath = imageFileName.StartsWith("http") || imageFileName.StartsWith("/")
                                    ? imageFileName
                                    : Url.Content("~/LayoutUser/img/featured/" + imageFileName);

                                    decimal unitPrice = GetFinalPrice(item.Variant);
                                    decimal itemTotal = unitPrice * item.Quantity;

                                    <tr id="cart-row-@item.VariantId">
                                        <td class="shoping__cart__item">
                                            <img src="@imagePath" alt="@productName" style="width: 80px; height: 80px; object-fit: cover; margin-right: 15px; border-radius: 5px;" />
                                            <h5>@productName</h5>
                                        </td>
                                        <td class="shoping__cart__price">
                                            @unitPrice.ToString("N0") đ
                                        </td>
                                        <td class="shoping__cart__quantity">
                                            <div class="quantity">
                                                <!-- Sử dụng class custom để tách biệt hoàn toàn với js cũ của template -->
                                                <div class="pro-qty custom-pro-qty" data-variant-id="@item.VariantId">
                                                    <input type="text" class="cart-qty-input" value="@item.Quantity" readonly>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="shoping__cart__total" id="item-total-@item.VariantId">
                                            @itemTotal.ToString("N0") đ
                                        </td>
                                        <td class="shoping__cart__item__close">
                                            <span class="icon_close btn-remove-item" data-variant-id="@item.VariantId" style="cursor: pointer;" title="Xóa sản phẩm"></span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="empty-cart-row">
                                    <td colspan="5" class="text-center py-4">
                                        <p>Giỏ hàng của bạn đang trống.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="shoping__cart__btns">
                    <a href="@Url.Action("Index", "Shop")" class="primary-btn cart-btn">TIẾP TỤC MUA SẮM</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="shoping__continue">
                    <div class="shoping__discount">
                        <h5>Mã giảm giá</h5>
                        <div class="d-flex align-items-center">
                            <input type="text" placeholder="Nhập mã giảm giá của bạn" class="form-control mr-2" style="height: 46px;">
                            <button type="button" class="site-btn" style="white-space: nowrap;">ÁP DỤNG</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="shoping__checkout">
                    <h5>Tổng giỏ hàng</h5>
                    <ul>
                        <li>Tạm tính <span id="cart-subtotal">@subTotal.ToString("N0") đ</span></li>
                        <li>Tổng cộng <span id="cart-total">@subTotal.ToString("N0") đ</span></li>
                    </ul>
                    <a href="@Url.Action("Index", "Checkout")" class="site-btn" style="display: block; text-align: center;">TIẾN HÀNH THANH TOÁN</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Shopping Cart Section End -->
@section Scripts {
    <script>
        $(document).ready(function () {
            // Tự động tạo nút +/- chuẩn xác cho giỏ hàng
            var $customQty = $('.custom-pro-qty');
            $customQty.each(function () {
                var $spinner = $(this);
                if ($spinner.find('.qtybtn').length === 0) {
                    $spinner.prepend('<span class="dec qtybtn">-</span>');
                    $spinner.append('<span class="inc qtybtn">+</span>');
                }
            });

            // Lắng nghe sự kiện click tăng giảm độc lập (tránh lỗi nhảy số 1 -> 3 -> 5)
            $(document).off('click.customQty').on('click.customQty', '.custom-pro-qty .qtybtn', function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                var $button = $(this);
                var $container = $button.parent();
                var variantId = $container.data('variant-id');
                var $input = $container.find('input');
                var oldValue = parseInt($input.val()) || 1;
                var newVal = oldValue;

                if ($button.hasClass('inc')) {
                    newVal = oldValue + 1;
                } else {
                    if (oldValue > 1) {
                        newVal = oldValue - 1;
                    } else {
                        newVal = 0;
                    }
                }

                $input.val(newVal);
                updateCartAjax(variantId, newVal);
            });

            // Xóa sản phẩm khỏi giỏ hàng
            $(document).on('click', '.btn-remove-item', function () {
                var variantId = $(this).data('variant-id');
                if (confirm("Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?")) {
                    updateCartAjax(variantId, 0);
                }
            });

            // Hàm gọi AJAX cập nhật giỏ hàng
            function updateCartAjax(variantId, quantity) {
                $.ajax({
                    url: '@Url.Action("UpdateQuantityAjax", "Cart")',
                    type: 'POST',
                    data: {
                        variantId: variantId,
                        quantity: quantity
                    },
                   success: function (res) {
                        if (res.success) {
                            if (res.isRemoved) {
                                $('#cart-row-' + variantId).fadeOut(300, function () {
                                    $(this).remove();
                                    if ($('#cart-items-body tr').length === 0) {
                                        $('#cart-items-body').html('<tr id="empty-cart-row"><td colspan="5" class="text-center py-4"><p>Giỏ hàng của bạn đang trống.</p></td></tr>');
                                    }
                                });
                            } else {
                                $('#item-total-' + variantId).text(res.itemTotal + ' đ');
                            }

                            // Cập nhật tổng tiền ở phần thanh toán góc phải trang giỏ hàng
                            $('#cart-subtotal').text(res.subTotal + ' đ');
                            $('#cart-total').text(res.subTotal + ' đ');

                            // CẬP NHẬT ĐỒNG BỘ SỐ LƯỢNG VÀ TỔNG TIỀN TRÊN HEADER
                            $('.header-cart__badge, .header-cart__badge-mobile, .nav-badge').text(res.cartCount);

                            // Cập nhật giá tiền hiển thị ở nút xem giỏ hàng ngoài Header
                            if (res.cartTotal) {
                                $('.header-cart__text strong').text(res.cartTotal);
                            } else {
                                $('.header-cart__text strong').text(res.subTotal + ' đ');
                            }
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi kết nối. Vui lòng thử lại!");
                    }
                });
            }
        });
    </script>
}