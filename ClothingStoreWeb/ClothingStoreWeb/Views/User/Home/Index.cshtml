@model IEnumerable<ClothingStoreWeb.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/User/Shared/LayoutUser.cshtml";
}

<!-- Categories Section Begin -->
<section class="categories">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Danh Mục Sản Phẩm</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="categories__slider owl-carousel">
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        <div class="categories__item set-bg" data-setbg="@Url.Content("~/LayoutUser/img/categories/" + (string.IsNullOrEmpty(cat.Thumbnail) ? "cat-1.jpg" : cat.Thumbnail.Trim()))">
                            <h5>
                                <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@cat.CategoryId">
                                    @cat.CategoryName
                                </a>
                            </h5>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
<!-- Categories Section End -->
<!-- Featured Section Begin -->
<section class="featured">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Sản Phẩm Nổi Bật</h2>
                </div>
                <div class="featured__controls">
                    <ul>
                        <li class="active" data-filter="*">Tất cả</li>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <li data-filter=".cat-@cat.CategoryId">@cat.CategoryName</li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="row featured__filter">
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-1.jpg" : item.Thumbnail.Trim();
                    <div class="col-lg-3 col-md-4 col-sm-6 mix cat-@item.CategoryId">
                        <div class="featured__item">
                            <div class="featured__item__pic set-bg" data-setbg="@Url.Content("~/LayoutUser/img/featured/" + imgFile)">
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="product-card-overlay-link"></a>
                                <ul class="featured__item__pic__hover">
                                    <li><a href="javascript:void(0)" class="ajax-toggle-favorite" data-id="@item.ProductId" title="Yêu thích"><i class="fa fa-heart"></i></a></li>
                                    <li><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" title="Chi tiết"><i class="fa fa-retweet"></i></a></li>
                                    <li><a href="javascript:void(0)" class="ajax-add-to-cart" data-id="@item.ProductId" title="Thêm vào giỏ hàng"><i class="fa fa-shopping-cart"></i></a></li>
                                </ul>
                            </div>
                            <div class="featured__item__text">
                                <h6>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">
                                        @item.ProductName
                                    </a>
                                </h6>
                                <h5>@item.MinPrice?.ToString("N0") đ</h5>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
<!-- Featured Section End -->
<!-- Banner Begin -->
<div class="banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6">
                <div class="banner__pic">
                    <img src="~/LayoutUser/img/banner/banner-01.jpg" alt="Banner 1">
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6">
                <div class="banner__pic">
                    <img src="~/LayoutUser/img/banner/banner-02.jpg" alt="Banner 2">
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Banner End -->
<!-- Latest Product Section Begin -->
<section class="latest-product">
    <div class="container">
        <div class="row">
            <!-- Cột 1: Latest Products -->
            <div class="col-lg-4 col-md-6">
                <div class="latest-product__text">
                    <h4>Sản phẩm mới nhất</h4>
                    <div class="latest-product__slider owl-carousel">
                        @if (ViewBag.LatestProducts != null)
                        {
                            var products = ViewBag.LatestProducts as List<ClothingStoreWeb.Models.Product>;
                            for (int i = 0; i < products.Count; i += 3)
                            {
                                <div class="latest-prdouct__slider__item">
                                    @foreach (var item in products.Skip(i).Take(3))
                                    {
                                        var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-1.jpg" : item.Thumbnail.Trim();
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="latest-product__item">
                                            <div class="latest-product__item__pic">
                                                <img src="@Url.Content("~/LayoutUser/img/featured/" + imgFile)" alt="@item.ProductName">
                                            </div>
                                            <div class="latest-product__item__text">
                                                <h6>@item.ProductName</h6>
                                                <span>@item.MinPrice?.ToString("N0") đ</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Cột 2: Top Rated Products -->
            <div class="col-lg-4 col-md-6">
                <div class="latest-product__text">
                    <h4>Đánh giá cao nhất</h4>
                    <div class="latest-product__slider owl-carousel">
                        @if (ViewBag.TopRatedProducts != null)
                        {
                            var products = ViewBag.TopRatedProducts as List<ClothingStoreWeb.Models.Product>;
                            for (int i = 0; i < products.Count; i += 3)
                            {
                                <div class="latest-prdouct__slider__item">
                                    @foreach (var item in products.Skip(i).Take(3))
                                    {
                                        var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-2.jpg" : item.Thumbnail.Trim();
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="latest-product__item">
                                            <div class="latest-product__item__pic">
                                                <img src="@Url.Content("~/LayoutUser/img/featured/" + imgFile)" alt="@item.ProductName">
                                            </div>
                                            <div class="latest-product__item__text">
                                                <h6>@item.ProductName</h6>
                                                <span>@item.MinPrice?.ToString("N0") đ</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Cột 3: Review Products -->
            <div class="col-lg-4 col-md-6">
                <div class="latest-product__text">
                    <h4>Nổi bật tuần</h4>
                    <div class="latest-product__slider owl-carousel">
                        @if (ViewBag.ReviewProducts != null)
                        {
                            var products = ViewBag.ReviewProducts as List<ClothingStoreWeb.Models.Product>;
                            for (int i = 0; i < products.Count; i += 3)
                            {
                                <div class="latest-prdouct__slider__item">
                                    @foreach (var item in products.Skip(i).Take(3))
                                    {
                                        var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-3.jpg" : item.Thumbnail.Trim();
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="latest-product__item">
                                            <div class="latest-product__item__pic">
                                                <img src="@Url.Content("~/LayoutUser/img/featured/" + imgFile)" alt="@item.ProductName">
                                            </div>
                                            <div class="latest-product__item__text">
                                                <h6>@item.ProductName</h6>
                                                <span>@item.MinPrice?.ToString("N0") đ</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Latest Product Section End -->
<!-- Blog Section Begin -->
<section class="from-blog">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title from-blog__title">
                    <h2>Tin Tức Thời Trang</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="from-blog__slider owl-carousel">
                    @if (ViewBag.Blogs != null)
                    {
                        foreach (var blog in ViewBag.Blogs)
                        {
                            <div class="blog__item">
                                <div class="blog__item__pic">
                                    <img src="@Url.Content("~/LayoutUser/img/blog/" + (string.IsNullOrEmpty(blog.Thumbnail) ? "blog-1.jpg" : blog.Thumbnail.Trim()))" alt="@blog.Title">
                                </div>
                                <div class="blog__item__text">
                                    <ul>
                                        <li><i class="fa fa-calendar-o"></i> @blog.CreatedDate?.ToString("dd/MM/yyyy")</li>
                                        <li><i class="fa fa-comment-o"></i> @blog.CommentCount</li>
                                    </ul>
                                    <h5><a asp-controller="Blog" asp-action="Index">@blog.Title</a></h5>
                                    <p>@blog.Description</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Blog Section End -->
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.set-bg').each(function () {
                var bg = $(this).data('setbg');
                if (bg) {
                    $(this).css('background-image', 'url(' + bg + ')');
                }
            });
        });
    </script>
}