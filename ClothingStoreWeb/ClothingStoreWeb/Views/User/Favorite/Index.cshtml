@model IEnumerable<ClothingStoreWeb.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
    Layout = "~/Views/User/Shared/LayoutUser.cshtml";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/LayoutUser/img/breadcrumb.jpg")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Sản Phẩm Yêu Thích</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <span>Yêu thích</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Favorite Products Section Begin -->
<section class="featured spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Danh Sách Yêu Thích (<span id="favPageCount">@(Model?.Count() ?? 0)</span>)</h2>
                </div>
            </div>
        </div>

        <div class="row featured__filter" id="favoriteContainer">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-1.jpg" : item.Thumbnail.Trim();
                    <div class="col-lg-3 col-md-4 col-sm-6 favorite-card-item" id="fav-item-@item.ProductId">
                        <div class="featured__item">
                            <div class="featured__item__pic set-bg" data-setbg="@Url.Content("~/LayoutUser/img/featured/" + imgFile)">
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="product-card-overlay-link"></a>
                                <ul class="featured__item__pic__hover">
                                    <li>
                                        <a href="javascript:void(0)" class="ajax-remove-favorite active-fav" data-id="@item.ProductId" title="Bỏ yêu thích">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" title="Xem chi tiết">
                                            <i class="fa fa-retweet"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)" class="ajax-add-to-cart" data-id="@item.ProductId" title="Thêm vào giỏ hàng">
                                            <i class="fa fa-shopping-cart"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <div class="featured__item__text">
                                <h6>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">
                                        @item.ProductName
                                    </a>
                                </h6>
                                <h5>@item.MinPrice?.ToString("N0") đ</h5>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12" id="emptyFavoriteBox">
                    <div class="checkout-card co-empty">
                        <i class="fa fa-heart-o"></i>
                        <p>Danh sách yêu thích của bạn đang trống. Hãy thả tim các sản phẩm bạn ưng ý nhé!</p>
                        <a asp-controller="Shop" asp-action="Index">Khám phá cửa hàng</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Favorite Products Section End -->
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.set-bg').each(function () {
                var bg = $(this).data('setbg');
                if (bg) {
                    $(this).css('background-image', 'url(' + bg + ')');
                }
            });
        });
    </script>
}