@model IEnumerable<ClothingStoreWeb.Models.Product>
@{
    ViewData["Title"] = "Cửa hàng";
    Layout = "~/Views/User/Shared/LayoutUser.cshtml";

    var categories = ViewBag.Categories as List<ClothingStoreWeb.Models.Category>;
    var latestProducts = ViewBag.LatestProducts as List<ClothingStoreWeb.Models.Product>;
    var discountProducts = ViewBag.DiscountProducts as List<ClothingStoreWeb.Models.Product>;

    string? currentCat = ViewBag.CurrentCategory as string;
    string? searchQuery = ViewBag.SearchQuery as string;
    int currentSort = ViewBag.Sort ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalProducts = ViewBag.TotalProducts ?? 0;
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/LayoutUser/img/breadcrumb.jpg")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Cửa Hàng Thời Trang</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <span>Cửa hàng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        <div class="row">
            <!-- Sidebar Begin -->
            <div class="col-lg-3 col-md-5">
                <div class="sidebar">
                    <!-- Danh mục sản phẩm -->
                    <div class="sidebar__item">
                        <h4>Danh mục</h4>
                        <ul>
                            <li class="@(string.IsNullOrEmpty(currentCat) ? "active" : "")">
                                <a asp-controller="Shop" asp-action="Index">
                                    Tất cả sản phẩm
                                </a>
                            </li>
                            @if (categories != null)
                            {
                                foreach (var cat in categories)
                                {
                                    bool isActive = currentCat == cat.CategoryId.ToString();
                                    <li class="@(isActive ? "active" : "")">
                                        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@cat.CategoryId">
                                            @cat.CategoryName
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>

                    <!-- Sản phẩm mới nhất -->
                    <div class="sidebar__item">
                        <div class="latest-product__text">
                            <h4>Sản phẩm mới</h4>
                            <div class="latest-product__slider owl-carousel">
                                @if (latestProducts != null && latestProducts.Any())
                                {
                                    for (int i = 0; i < latestProducts.Count; i += 3)
                                    {
                                        <div class="latest-prdouct__slider__item">
                                            @foreach (var item in latestProducts.Skip(i).Take(3))
                                            {
                                                var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-1.jpg" : item.Thumbnail.Trim();
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="latest-product__item">
                                                    <div class="latest-product__item__pic">
                                                        <img src="@Url.Content("~/LayoutUser/img/featured/" + imgFile)" alt="@item.ProductName">
                                                    </div>
                                                    <div class="latest-product__item__text">
                                                        <h6>@item.ProductName</h6>
                                                        <span>@item.MinPrice?.ToString("N0") đ</span>
                                                    </div>
                                                </a>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sidebar End -->
            <!-- Product List Begin -->
            <div class="col-lg-9 col-md-7">
                <!-- Khối Khuyến mãi (Sale Off) -->
                @if (discountProducts != null && discountProducts.Any())
                {
                    <div class="product__discount">
                        <div class="section-title product__discount__title">
                            <h2>Khuyến mãi</h2>
                        </div>
                        <div class="row">
                            <div class="product__discount__slider owl-carousel">
                                @foreach (var item in discountProducts)
                                {
                                    var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-1.jpg" : item.Thumbnail.Trim();
                                    var oldPrice = (item.MinPrice ?? 0) * 1.2m;
                                    <div class="col-lg-4">
                                        <div class="product__discount__item">
                                            <div class="product__discount__item__pic set-bg"
                                                 data-setbg="@Url.Content("~/LayoutUser/img/featured/" + imgFile)">
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="product-card-overlay-link"></a>
                                                <div class="product__discount__percent">-20%</div>
                                                <ul class="product__item__pic__hover">
                                                    <li><a href="#"><i class="fa fa-heart"></i></a></li>
                                                    <li><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId"><i class="fa fa-retweet"></i></a></li>
                                                    <li><a href="javascript:void(0)" class="ajax-add-to-cart" data-id="@item.ProductId" title="Thêm vào giỏ hàng"><i class="fa fa-shopping-cart"></i></a></li>
                                                </ul>
                                            </div>
                                            <div class="product__discount__item__text">
                                                <span>@(item.Category?.CategoryName ?? "Thời trang")</span>
                                                <h5><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a></h5>
                                                <div class="product__item__price">@item.MinPrice?.ToString("N0") đ <span>@oldPrice.ToString("N0") đ</span></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Thanh công cụ Sắp xếp & Số lượng -->
                <div class="filter__item">
                    <div class="row">
                        <div class="col-lg-4 col-md-5">
                            <div class="filter__sort">
                                <span>Sắp xếp</span>
                                <select onchange="location = this.value;">
                                    <option value="@Url.Action("Index", "Shop", new { categoryId = currentCat, query = searchQuery, sort = 0 })" selected="@(currentSort == 0 ? "selected" : null)">Mặc định</option>
                                    <option value="@Url.Action("Index", "Shop", new { categoryId = currentCat, query = searchQuery, sort = 1 })" selected="@(currentSort == 1 ? "selected" : null)">Giá tăng dần</option>
                                    <option value="@Url.Action("Index", "Shop", new { categoryId = currentCat, query = searchQuery, sort = 2 })" selected="@(currentSort == 2 ? "selected" : null)">Giá giảm dần</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4">
                            <div class="filter__found">
                                <h6>Tìm thấy <span>@totalProducts</span> sản phẩm</h6>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-3">
                            <div class="filter__option">
                                <span class="icon_grid-2x2"></span>
                                <span class="icon_ul"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Danh sách sản phẩm chính -->
                <div class="row shop-grid-products">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var imgFile = string.IsNullOrEmpty(item.Thumbnail) ? "feature-1.jpg" : item.Thumbnail.Trim();
                            <div class="col-lg-4 col-md-6 col-sm-6">
                                <div class="product__item">
                                    <div class="product__item__pic set-bg" data-setbg="@Url.Content("~/LayoutUser/img/featured/" + imgFile)">
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="product-card-overlay-link"></a>
                                        <ul class="product__item__pic__hover">
                                            <li><a href="#"><i class="fa fa-heart"></i></a></li>
                                            <li><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId"><i class="fa fa-retweet"></i></a></li>
                                            <li><a href="javascript:void(0)" class="ajax-add-to-cart" data-id="@item.ProductId" title="Thêm vào giỏ hàng"><i class="fa fa-shopping-cart"></i></a></li>
                                        </ul>
                                    </div>
                                    <div class="product__item__text">
                                        <h6><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a></h6>
                                        <h5>@item.MinPrice?.ToString("N0") đ</h5>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <h5>Không tìm thấy sản phẩm nào phù hợp.</h5>
                        </div>
                    }
                </div>

                <!-- Phân trang -->
                @if (totalPages > 1)
                {
                    <div class="product__pagination">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <a asp-controller="Shop" asp-action="Index"
                               asp-route-categoryId="@currentCat"
                               asp-route-query="@searchQuery"
                               asp-route-sort="@currentSort"
                               asp-route-page="@i"
                               class="@(i == currentPage ? "active" : "")">
                                @i
                            </a>
                        }
                        @if (currentPage < totalPages)
                        {
                            <a asp-controller="Shop" asp-action="Index"
                               asp-route-categoryId="@currentCat"
                               asp-route-query="@searchQuery"
                               asp-route-sort="@currentSort"
                               asp-route-page="@(currentPage + 1)">
                                <i class="fa fa-long-arrow-right"></i>
                            </a>
                        }
                    </div>
                }
            </div>
            <!-- Product List End -->
        </div>
    </div>
</section>
<!-- Product Section End -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof $.fn.owlCarousel !== 'undefined') {
                $('.product__discount__slider').owlCarousel({
                    loop: true,
                    margin: 0,
                    items: 3,
                    dots: true,
                    smartSpeed: 1200,
                    autoPlay: true,
                    responsive: {
                        320: { items: 1 },
                        768: { items: 2 },
                        992: { items: 3 }
                    }
                });
            }

            $('.set-bg').each(function () {
                var bg = $(this).data('setbg');
                if (bg) {
                    $(this).css('background-image', 'url(' + bg + ')');
                }
            });
        });
    </script>
}