@model List<ClothingStoreWeb.Models.Order>

@{
    ViewData["Title"] = "Tra cứu đơn hàng";
    Layout = "~/Views/User/Shared/LayoutUser.cshtml";
    string searchCode = ViewBag.SearchCode as string ?? "";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/LayoutUser/img/breadcrumb.jpg")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Tra Cứu Trạng Thái Đơn Hàng</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <span>Tra cứu đơn hàng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Track Order Section Begin -->
<section class="shoping-cart spad">
    <div class="container">
        <!-- Form tìm kiếm / tra cứu theo mã đơn hàng -->
        <div class="row mb-5">
            <div class="col-lg-8 offset-lg-2">
                <form asp-controller="Order" asp-action="TrackOrder" method="get" class="card p-4 shadow-sm border-0" style="background: #f5f5f5; border-radius: 8px;">
                    <h5 class="mb-3 font-weight-bold text-dark"><i class="fa fa-search mr-2"></i> Nhập mã đơn hàng để tra cứu</h5>
                    <div class="input-group">
                        <input type="text" name="orderCode" value="@searchCode" class="form-control form-control-lg" placeholder="Ví dụ: HD20261020..." style="font-size: 15px;" />
                        <div class="input-group-append">
                            <button type="submit" class="site-btn px-4" style="border-radius: 0 4px 4px 0;">TRA CỨU</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="row">
                <div class="col-lg-12 text-center py-4">
                    <div class="mb-3">
                        <i class="fa fa-file-text-o" style="font-size: 50px; color: #b2b2b2;"></i>
                    </div>
                    <h4>Không tìm thấy đơn hàng phù hợp.</h4>
                    <p class="text-muted">Vui lòng kiểm tra lại mã đơn hàng hoặc xem lại toàn bộ lịch sử mua sắm của bạn.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-12">
                    @foreach (var order in Model)
                    {
                        <div class="card mb-4 shadow-sm" style="border: 1px solid #ebebeb; border-radius: 8px; overflow: hidden;">
                            <!-- Header đơn hàng kèm thanh trạng thái -->
                            <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4 flex-wrap">
                                <div>
                                    <span class="font-weight-bold text-dark mr-3" style="font-size: 16px;">Mã đơn: #@order.OrderId</span>
                                    <span class="text-muted small"><i class="fa fa-calendar"></i> @order.OrderDate?.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="d-flex align-items-center mt-2 mt-md-0">
                                    <!-- Hiển thị Badge Trạng thái trực quan -->
                                    <span class="badge badge-warning px-3 py-2 mr-2" style="font-size: 12px; font-weight: 600; background: #fff3cd; color: #856404;">
                                        <i class="fa fa-clock-o"></i> Đang chờ xác nhận / Chuẩn bị hàng
                                    </span>
                                    <span class="badge badge-pill badge-success px-3 py-2" style="font-size: 12px; font-weight: 600;">
                                        @(order.PaymentMethod == 0 ? "COD" : order.PaymentMethod == 1 ? "Chuyển khoản" : "MoMo")
                                    </span>
                                </div>
                            </div>

                            <!-- Danh sách sản phẩm trong đơn -->
                            <div class="card-body p-4">
                                <div class="table-responsive">
                                    <table class="table table-borderless mb-0">
                                        <thead>
                                            <tr class="text-muted small border-bottom">
                                                <th style="width: 50%;">Sản phẩm</th>
                                                <th style="width: 20%;">Đơn giá</th>
                                                <th style="width: 10%;">Số lượng</th>
                                                <th style="width: 20%;" class="text-right">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.OrderDetails)
                                            {
                                                var productName = item.Variant?.Product?.ProductName ?? "Sản phẩm thời trang";
                                                decimal unitPrice = item.UnitPrice ?? 0;
                                                decimal lineTotal = unitPrice * (item.Quantity ?? 0);

                                                <tr class="align-middle">
                                                    <td>
                                                        <span class="font-weight-bold text-dark">@productName</span>
                                                    </td>
                                                    <td>@unitPrice.ToString("N0") đ</td>
                                                    <td>@(item.Quantity ?? 0)</td>
                                                    <td class="text-right font-weight-bold text-danger">@lineTotal.ToString("N0") đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Footer card: Nút hủy đơn (nếu chưa giao) & Tổng tiền -->
                            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 px-4 border-top flex-wrap">
                                <div>
                                    @if (!string.IsNullOrEmpty(order.Notes))
                                    {
                                        <small class="text-muted"><strong>Ghi chú:</strong> @order.Notes</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Không có ghi chú</small>
                                    }
                                </div>

                                <div class="d-flex align-items-center mt-2 mt-md-0">
                                    <!-- Nút Hủy đơn hàng (Chỉ cho phép khi đơn chưa giao) -->
                                    <form asp-controller="Order" asp-action="CancelOrder" method="post" class="mr-3" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-1 font-weight-bold" style="border-radius: 4px;">
                                            <i class="fa fa-times mr-1"></i> Hủy đơn hàng
                                        </button>
                                    </form>

                                    <div class="text-right">
                                        <span class="text-muted mr-2">Tổng thanh toán:</span>
                                        <span class="text-danger font-weight-bold" style="font-size: 20px;">
                                            @order.TotalAmount?.ToString("N0") đ
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
<!-- Track Order Section End -->