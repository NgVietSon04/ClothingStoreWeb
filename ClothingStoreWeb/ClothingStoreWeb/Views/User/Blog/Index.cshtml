@model IEnumerable<ClothingStoreWeb.Models.Blog>

@{
    ViewData["Title"] = "Bài viết";
    Layout = "~/Views/User/Shared/LayoutUser.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<style>
    /* Tùy chỉnh thu nhỏ và đồng bộ kích thước ảnh trang Blog cho gọn gàng và đẹp mắt */
    .blog__item__pic img {
        width: 100% !important;
        height: 190px !important;
        object-fit: cover !important;
        border-radius: 8px !important;
    }

    .blog__sidebar__recent__item__pic img {
        width: 60px !important;
        height: 60px !important;
        object-fit: cover !important;
        border-radius: 6px !important;
    }

    .blog__sidebar__banner img {
        width: 100% !important;
        max-height: 220px !important;
        object-fit: cover !important;
        border-radius: 8px !important;
    }
</style>

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/LayoutUser/img/breadcrumb.jpg")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Tin Tức Thời Trang</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <span>Bài viết</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Blog Section Begin -->
<section class="blog spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-5">
                <div class="blog__sidebar">
                    <div class="blog__sidebar__search">
                        <form action="#">
                            <input type="text" placeholder="Tìm kiếm bài viết...">
                            <button type="submit"><span class="icon_search"></span></button>
                        </form>
                    </div>
                    <div class="blog__sidebar__item">
                        <h4>Chuyên mục</h4>
                        <ul>
                            <li><a href="#">Tất cả</a></li>
                            <li><a href="#">Xu hướng (20)</a></li>
                            <li><a href="#">Phối đồ (5)</a></li>
                            <li><a href="#">Phong cách sống (9)</a></li>
                            <li><a href="#">Sự kiện (10)</a></li>
                        </ul>
                    </div>
                    <div class="blog__sidebar__item">
                        <h4>Bài viết mới</h4>
                        <div class="blog__sidebar__recent">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var recent in Model.Take(3))
                                {
                                    var recentThumb = string.IsNullOrEmpty(recent.Thumbnail) ? "blog-1.jpg" : recent.Thumbnail.Trim();
                                    <a href="#" class="blog__sidebar__recent__item">
                                        <div class="blog__sidebar__recent__item__pic">
                                            <img src="@Url.Content("~/LayoutUser/img/blog/" + recentThumb)" alt="@recent.Title" />
                                        </div>
                                        <div class="blog__sidebar__recent__item__text">
                                            <h6>@recent.Title</h6>
                                            <span>@(recent.CreatedDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                    <div class="blog__sidebar__item">
                        <h4>Từ khóa</h4>
                        <div class="blog__sidebar__item__tags">
                            <a href="#">Thời trang</a>
                            <a href="#">Làm đẹp</a>
                            <a href="#">Thu Đông</a>
                            <a href="#">Streetwear</a>
                            <a href="#">Phụ kiện</a>
                            <a href="#">Lifestyle</a>
                        </div>
                    </div>

                    <!-- Sidebar Banner Begin -->
                    <div class="blog__sidebar__item">
                        <div class="blog__sidebar__banner">
                            <a asp-controller="Shop" asp-action="Index">
                                <img src="@Url.Content("~/LayoutUser/img/banner/banner-01.jpg")" alt="Banner Quảng Cáo" />
                            </a>
                        </div>
                    </div>
                    <!-- Sidebar Banner End -->
                </div>
            </div>

            <div class="col-lg-8 col-md-7">
                <div class="row">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var itemThumb = string.IsNullOrEmpty(item.Thumbnail) ? "blog-1.jpg" : item.Thumbnail.Trim();
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <div class="blog__item">
                                    <div class="blog__item__pic">
                                        <img src="@Url.Content("~/LayoutUser/img/blog/" + itemThumb)" alt="@item.Title" />
                                    </div>
                                    <div class="blog__item__text">
                                        <ul>
                                            <li><i class="fa fa-calendar-o"></i> @(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "N/A")</li>
                                            <li><i class="fa fa-comment-o"></i> @(item.CommentCount ?? 0)</li>
                                        </ul>
                                        <h5><a href="#">@item.Title</a></h5>
                                        <p>@item.Description</p>
                                        <a href="#" class="blog__btn">XEM THÊM <span class="arrow_right"></span></a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <p>Chưa có bài viết nào.</p>
                        </div>
                    }

                    <!-- Pagination Dynamic Begin -->
                    @if (totalPages > 1)
                    {
                        <div class="col-lg-12">
                            <div class="product__pagination blog__pagination">
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <a asp-controller="Blog" asp-action="Index" asp-route-page="@i" class="@(i == currentPage ? "active" : "")">@i</a>
                                }

                                @if (currentPage < totalPages)
                                {
                                    <a asp-controller="Blog" asp-action="Index" asp-route-page="@(currentPage + 1)">
                                        <i class="fa fa-long-arrow-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    <!-- Pagination Dynamic End -->
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Blog Section End -->
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.set-bg').each(function () {
                var bg = $(this).data('setbg');
                if (bg) {
                    $(this).css('background-image', 'url(' + bg + ')');
                }
            });
        });
    </script>
}