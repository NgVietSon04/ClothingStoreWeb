@model PagedList<ProductVariant>
@{
    ViewData["Title"] = "Biến thể & tồn kho";
}
<div class="page-head">
    <div><h1><i class="bi bi-boxes"></i> Biến thể &amp; tồn kho</h1><p class="text-muted mb-0">Tổng cộng @Model.TotalItems biến thể</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm biến thể</a>
</div>
<div class="card"><div class="card-body">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm mã biến thể, tên sản phẩm..." /></div>
        <div class="col-md-3"><select name="productId" class="form-select" asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Products, "Value", "Text", (string?)ViewBag.ProductId))"><option value="">Mọi sản phẩm</option></select></div>
        <div class="col-auto d-flex align-items-center"><div class="form-check"><input class="form-check-input" type="checkbox" name="lowStock" value="true" id="ls" @(ViewBag.LowStock == true ? "checked" : "") /><label for="ls" class="form-check-label">Sắp hết (≤ 10)</label></div></div>
        <div class="col-auto"><button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Lọc</button> <a asp-action="Index" class="btn btn-link">Xóa lọc</a></div>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Ảnh</th><th>Mã</th><th>Sản phẩm</th><th>Size</th><th>Màu</th><th>Đơn giá</th><th>Giảm</th><th>Tồn kho</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var v in Model.Items)
            {
                <tr>
                    <td><img src="@AdminUi.Img(v.Thumbnail)" class="thumb" alt="" onerror="this.style.opacity=0" /></td>
                    <td>@v.VariantId</td>
                    <td>@v.Product?.ProductName</td>
                    <td>@v.SizeId</td>
                    <td>@v.Color?.ColorName</td>
                    <td>@AdminUi.MoneyD(v.UnitPrice)</td>
                    <td>@v.Discount %</td>
                    <td><span class="badge @((v.StockQuantity ?? 0) == 0 ? "bg-danger" : (v.StockQuantity ?? 0) <= 10 ? "bg-warning text-dark" : "bg-success")">@v.StockQuantity</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@v.VariantId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-delete-url="@Url.Action("Delete", new { id = v.VariantId })" data-delete-name="@v.VariantId"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
</div></div>
