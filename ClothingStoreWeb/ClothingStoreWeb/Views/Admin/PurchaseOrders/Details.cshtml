@model PurchaseOrder
@{
    ViewData["Title"] = "Phiếu nhập " + Model.PurchaseOrderId;
}
<div class="page-head">
    <h1><i class="bi bi-box-arrow-in-down"></i> Phiếu nhập @Model.PurchaseOrderId</h1>
    <div class="d-flex gap-2 no-print">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Danh sách</a>
        <button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> In</button>
        <a asp-action="Edit" asp-route-id="@Model.PurchaseOrderId" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
    </div>
</div>
<div class="card mb-3"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Ngày nhập</dt><dd class="col-sm-9">@Model.ImportDate?.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Nhà cung cấp</dt><dd class="col-sm-9">@Model.Supplier?.SupplierName</dd>
        <dt class="col-sm-3">Nhân viên</dt><dd class="col-sm-9">@Model.Employee?.FullName</dd>
        <dt class="col-sm-3">Ghi chú</dt><dd class="col-sm-9">@Model.Notes</dd>
    </dl>
</div></div>
<div class="card"><div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Sản phẩm</th><th>Biến thể</th><th class="text-end">SL</th><th class="text-end">Giá nhập</th><th class="text-end">Thành tiền</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Details)
        {
            <tr><td>@d.Variant?.Product?.ProductName</td><td>@d.VariantId</td><td class="text-end">@d.Quantity</td><td class="text-end">@AdminUi.Money(d.ImportPrice)</td><td class="text-end">@AdminUi.Money(d.Quantity * d.ImportPrice)</td></tr>
        }
        </tbody>
    </table>
</div>
<div class="card-body"><div class="totals"><div class="row-t grand"><span>Tổng cộng</span><span>@AdminUi.Money(Model.TotalAmount)</span></div></div></div></div>
