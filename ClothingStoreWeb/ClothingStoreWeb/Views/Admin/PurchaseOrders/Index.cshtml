@model PagedList<PurchaseOrder>
@{
    ViewData["Title"] = "Nhập kho";
}
<div class="page-head">
    <div><h1><i class="bi bi-box-arrow-in-down"></i> Nhập kho</h1><p class="text-muted mb-0">Tổng cộng @Model.TotalItems phiếu</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tạo phiếu nhập</a>
</div>
<div class="card"><div class="card-body">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-3"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Mã phiếu, nhà cung cấp..." /></div>
        <div class="col-md-3"><select name="supplierId" class="form-select" asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Suppliers, "Value", "Text", (string?)ViewBag.SupplierId))"><option value="">Mọi nhà cung cấp</option></select></div>
        <div class="col-md-2"><input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" /></div>
        <div class="col-md-2"><input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" /></div>
        <div class="col-auto"><button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Lọc</button> <a asp-action="Index" class="btn btn-link">Xóa lọc</a></div>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã phiếu</th><th>Ngày nhập</th><th>Nhà cung cấp</th><th>Nhân viên</th><th class="text-end">Tổng tiền</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@p.PurchaseOrderId">@p.PurchaseOrderId</a></td>
                    <td>@p.ImportDate?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@p.Supplier?.SupplierName</td>
                    <td>@p.Employee?.FullName</td>
                    <td class="text-end">@AdminUi.Money(p.TotalAmount)</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@p.PurchaseOrderId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@p.PurchaseOrderId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-delete-url="@Url.Action("Delete", new { id = p.PurchaseOrderId })" data-delete-name="phiếu @p.PurchaseOrderId"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có phiếu nhập</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
</div></div>
