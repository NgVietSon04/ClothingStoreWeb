@model PurchaseOrderFormVm
@{
    var isEdit = !string.IsNullOrEmpty(Model.PurchaseOrderId);
    ViewData["Title"] = isEdit ? "Sửa phiếu nhập " + Model.PurchaseOrderId : "Tạo phiếu nhập";
    var suppliers = (IEnumerable<SelectListItem>)ViewBag.Suppliers;
    var employees = (IEnumerable<SelectListItem>)ViewBag.Employees;
    var variants = (List<VariantPickVm>)ViewBag.Variants;
}
<div class="page-head">
    <h1><i class="bi bi-box-arrow-in-down"></i> @ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<form method="post" action="@(isEdit ? Url.Action("Edit", new { id = Model.PurchaseOrderId }) : Url.Action("Create"))">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-md-4"><label class="form-label">Ngày nhập</label><input asp-for="ImportDate" type="datetime-local" value="@Model.ImportDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Nhà cung cấp <span class="text-danger">*</span></label>
            <select asp-for="SupplierId" asp-items="suppliers" class="form-select"><option value="">-- Chọn --</option></select></div>
        <div class="col-md-4"><label class="form-label">Nhân viên</label>
            <select asp-for="EmployeeId" asp-items="employees" class="form-select"><option value="">-- Chọn --</option></select></div>
        <div class="col-12"><label class="form-label">Ghi chú</label><input asp-for="Notes" class="form-control" /></div>
    </div></div></div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center"><span>Hàng nhập</span>
            <button type="button" id="btnAddRow" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i> Thêm dòng</button></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" data-mode="po">
                <thead><tr><th style="min-width:300px">Biến thể</th><th style="width:110px">SL</th><th style="width:170px">Giá nhập</th><th class="text-end" style="width:150px">Thành tiền</th><th style="width:50px"></th></tr></thead>
                <tbody id="itemRows">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var it = Model.Items[i];
                    <tr>
                        <td><select data-field="VariantId" name="Items[@i].VariantId" class="form-select variant-select">
                            <option value="">-- Chọn biến thể --</option>
                            @foreach (var v in variants) { <option value="@v.Id" selected="@(v.Id == it.VariantId)">@v.Text</option> }
                        </select></td>
                        <td><input data-field="Quantity" name="Items[@i].Quantity" type="number" min="1" value="@it.Quantity" class="form-control qty" /></td>
                        <td><input data-field="ImportPrice" name="Items[@i].ImportPrice" type="number" min="0" step="any" value="@AdminUi.Num(it.ImportPrice)" class="form-control price" /></td>
                        <td class="text-end line-total">0 ₫</td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="bi bi-x-lg"></i></button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-body"><div class="totals"><div class="row-t grand"><span>Tổng cộng</span><span id="sumTotal">0 ₫</span></div></div></div>
    </div>

    <template id="rowTemplate">
        <tr>
            <td><select data-field="VariantId" class="form-select variant-select">
                <option value="">-- Chọn biến thể --</option>
                @foreach (var v in variants) { <option value="@v.Id">@v.Text</option> }
            </select></td>
            <td><input data-field="Quantity" type="number" min="1" value="1" class="form-control qty" /></td>
            <td><input data-field="ImportPrice" type="number" min="0" step="any" value="0" class="form-control price" /></td>
            <td class="text-end line-total">0 ₫</td>
            <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="bi bi-x-lg"></i></button></td>
        </tr>
    </template>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Lưu phiếu nhập</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
    <p class="text-muted small mt-2">Tồn kho sẽ tự động được cộng khi lưu (và điều chỉnh khi sửa / xóa phiếu).</p>
</form>
