@model IPaged
@if (Model.TotalPages > 1)
{
    var path = Context.Request.Path.Value ?? "";
    var keep = Context.Request.Query
        .Where(k => k.Key != "page")
        .ToDictionary(k => k.Key, k => (string?)k.Value.ToString());

    string PageUrl(int p)
    {
        var d = new Dictionary<string, string?>(keep) { ["page"] = p.ToString() };
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(path, d);
    }

    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, Model.Page + 2);

    <nav class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <small class="text-muted">Trang @Model.Page / @Model.TotalPages · @Model.TotalItems bản ghi</small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page - 1)">«</a></li>
            @if (from > 1)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                @if (from > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            }
            @for (var i = from; i <= to; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@PageUrl(i)">@i</a></li>
            }
            @if (to < Model.TotalPages)
            {
                @if (to < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page + 1)">»</a></li>
        </ul>
    </nav>
}
