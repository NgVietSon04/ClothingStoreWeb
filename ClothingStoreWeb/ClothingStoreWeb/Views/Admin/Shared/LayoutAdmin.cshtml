<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin Panda Store</title>

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/LayoutAdmin/css/admin.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    @{
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string Active(params string[] names) => names.Contains(ctrl) ? "active" : "";
        var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Admin";
    }

    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-bag-heart-fill"></i> Shop Admin</a>

        <nav class="nav flex-column">
            <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Tổng quan</a>

            <div class="nav-title">Bán hàng</div>
            <a class="nav-link @Active("Orders")" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng</a>
            <a class="nav-link @Active("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-person-heart"></i> Khách hàng</a>
            <a class="nav-link @Active("CustomerAddresses")" asp-controller="CustomerAddresses" asp-action="Index"><i class="bi bi-geo-alt"></i> Sổ địa chỉ</a>
            <a class="nav-link @Active("Reviews")" asp-controller="Reviews" asp-action="Index"><i class="bi bi-star"></i> Đánh giá</a>
            <a class="nav-link @Active("Promotions")" asp-controller="Promotions" asp-action="Index"><i class="bi bi-ticket-perforated"></i> Khuyến mãi</a>
            <a class="nav-link @Active("Carts")" asp-controller="Carts" asp-action="Index"><i class="bi bi-cart3"></i> Giỏ hàng</a>
            <a class="nav-link @Active("Wishlists")" asp-controller="Wishlists" asp-action="Index"><i class="bi bi-heart"></i> Yêu thích</a>

            <div class="nav-title">Sản phẩm</div>
            <a class="nav-link @Active("Products")" asp-controller="Products" asp-action="Index"><i class="bi bi-bag"></i> Sản phẩm</a>
            <a class="nav-link @Active("ProductVariants")" asp-controller="ProductVariants" asp-action="Index"><i class="bi bi-boxes"></i> Biến thể &amp; tồn kho</a>
            <a class="nav-link @Active("Categories")" asp-controller="Categories" asp-action="Index"><i class="bi bi-grid"></i> Danh mục</a>
            <a class="nav-link @Active("Brands")" asp-controller="Brands" asp-action="Index"><i class="bi bi-award"></i> Thương hiệu</a>
            <a class="nav-link @Active("Materials")" asp-controller="Materials" asp-action="Index"><i class="bi bi-layers"></i> Chất liệu</a>
            <a class="nav-link @Active("TargetAudiences")" asp-controller="TargetAudiences" asp-action="Index"><i class="bi bi-people"></i> Đối tượng</a>
            <a class="nav-link @Active("Sizes")" asp-controller="Sizes" asp-action="Index"><i class="bi bi-rulers"></i> Kích cỡ</a>
            <a class="nav-link @Active("Colors")" asp-controller="Colors" asp-action="Index"><i class="bi bi-palette"></i> Màu sắc</a>
            <a class="nav-link @Active("Countries")" asp-controller="Countries" asp-action="Index"><i class="bi bi-globe"></i> Quốc gia</a>

            <div class="nav-title">Kho</div>
            <a class="nav-link @Active("PurchaseOrders")" asp-controller="PurchaseOrders" asp-action="Index"><i class="bi bi-box-arrow-in-down"></i> Nhập kho</a>
            <a class="nav-link @Active("Suppliers")" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i> Nhà cung cấp</a>

            <div class="nav-title">Hệ thống</div>
            <a class="nav-link @Active("Blogs")" asp-controller="Blogs" asp-action="Index"><i class="bi bi-journal-text"></i> Blog</a>
            <a class="nav-link @Active("Employees")" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-badge"></i> Nhân viên</a>
            <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-lock"></i> Tài khoản</a>
        </nav>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-light d-lg-none" type="button" id="btnSidebar"><i class="bi bi-list"></i></button>
            <div class="ms-auto d-flex align-items-center gap-3">
                <span class="text-muted"><i class="bi bi-person-circle"></i> @fullName</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                </form>
            </div>
        </header>

        <main class="content">
            @if (TempData["Ok"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show auto-dismiss" role="alert">
                    <i class="bi bi-check-circle"></i> @ok
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Err"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @err
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Modal xác nhận xóa dùng chung -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" id="deleteForm" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-trash text-danger"></i> Xác nhận xóa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Bạn có chắc muốn xóa <strong id="deleteName"></strong>? Thao tác này không thể hoàn tác.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/LayoutAdmin/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
