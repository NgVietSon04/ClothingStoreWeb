@model PagedList<CustomerAddress>
@{
    ViewData["Title"] = "Sổ địa chỉ khách hàng";
}

<div class="page-head">
    <div>
        <h1><i class="bi bi-geo-alt"></i> Sổ địa chỉ khách hàng</h1>
        <p class="text-muted mb-0">Tổng cộng @Model.TotalItems bản ghi</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm mới</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-5">
                <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm kiếm..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i> Tìm</button>
                @if (!string.IsNullOrEmpty((string?)ViewBag.Q))
                {
                    <a asp-action="Index" class="btn btn-link">Xóa lọc</a>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách hàng</th>
                        <th>Người nhận</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ chi tiết</th>
                        <th>Địa chỉ mặc định</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.AddressId</td>
                            <td>@AdminUi.Lk(ViewData, "CustomerIdOptions", item.CustomerId)</td>
                            <td>@item.RecipientName</td>
                            <td>@item.PhoneNumber</td>
                            <td>@AdminUi.Trunc(item.AddressDetail, 60)</td>
                            <td>@if (item.IsDefault) { <span class="badge bg-success">Có</span> } else { <span class="badge bg-secondary">Không</span> }</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.AddressId" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa"
                                        data-delete-url="@Url.Action("Delete", new { id = item.AddressId })"
                                        data-delete-name="@item.RecipientName"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model" />
    </div>
</div>
