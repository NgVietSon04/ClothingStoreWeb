@model Product
@{
    ViewData["Title"] = Model.ProductName;
}
<div class="page-head">
    <h1><i class="bi bi-bag"></i> @Model.ProductName <small class="text-muted fs-6">@Model.ProductId</small></h1>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Danh sách</a>
        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4"><div class="card"><div class="card-body text-center">
        <img src="@AdminUi.Img(Model.Thumbnail)" class="img-fluid rounded" alt="" onerror="this.style.opacity=0" />
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Danh mục</dt><dd class="col-sm-9">@Model.Category?.CategoryName</dd>
            <dt class="col-sm-3">Thương hiệu</dt><dd class="col-sm-9">@Model.Brand?.BrandName</dd>
            <dt class="col-sm-3">Đối tượng</dt><dd class="col-sm-9">@Model.Audience?.AudienceName</dd>
            <dt class="col-sm-3">Chất liệu</dt><dd class="col-sm-9">@Model.Material?.MaterialName</dd>
            <dt class="col-sm-3">Xuất xứ</dt><dd class="col-sm-9">@Model.OriginCountry?.CountryName</dd>
            <dt class="col-sm-3">Form / Mùa</dt><dd class="col-sm-9">@Model.FitType · @Model.Season</dd>
            <dt class="col-sm-3">Style code</dt><dd class="col-sm-9">@Model.StyleCode</dd>
            <dt class="col-sm-3">Khối lượng</dt><dd class="col-sm-9">@Model.Weight kg</dd>
            <dt class="col-sm-3">Bảo hành</dt><dd class="col-sm-9">@Model.WarrantyDays ngày</dd>
            <dt class="col-sm-3">Giảm giá</dt><dd class="col-sm-9">@Model.DiscountPercent %</dd>
            <dt class="col-sm-3">Khoảng giá</dt><dd class="col-sm-9">@AdminUi.Money(Model.MinPrice) – @AdminUi.Money(Model.MaxPrice)</dd>
            <dt class="col-sm-3">Bảo quản</dt><dd class="col-sm-9">@Model.CareInstructions</dd>
            <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.Description</dd>
        </dl>
    </div></div></div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Biến thể (@Model.Variants.Count)</span>
        <a asp-controller="ProductVariants" asp-action="Create" asp-route-productId="@Model.ProductId" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Thêm biến thể</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Ảnh</th><th>Mã</th><th>Size</th><th>Màu</th><th>Đơn giá</th><th>Giảm</th><th>Tồn kho</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var v in Model.Variants.OrderBy(v => v.VariantId))
            {
                <tr>
                    <td><img src="@AdminUi.Img(v.Thumbnail)" class="thumb" alt="" onerror="this.style.opacity=0" /></td>
                    <td>@v.VariantId</td>
                    <td>@v.Size?.SizeName</td>
                    <td>@v.Color?.ColorName</td>
                    <td>@AdminUi.MoneyD(v.UnitPrice)</td>
                    <td>@v.Discount %</td>
                    <td><span class="badge @((v.StockQuantity ?? 0) <= 10 ? "bg-warning text-dark" : "bg-success")">@v.StockQuantity</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-controller="ProductVariants" asp-action="Edit" asp-route-id="@v.VariantId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-delete-url="@Url.Action("Delete", "ProductVariants", new { id = v.VariantId })" data-delete-name="@v.VariantId"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            @if (!Model.Variants.Any()) { <tr><td colspan="8" class="text-center text-muted py-3">Chưa có biến thể</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header">Thư viện ảnh (@Model.Images.Count)</div>
    <div class="card-body">
        <div class="gallery mb-3">
            @foreach (var img in Model.Images.OrderBy(i => i.SortOrder))
            {
                <div class="g-item">
                    <img src="@AdminUi.Img(img.ImageFileName)" alt="" onerror="this.style.opacity=0" />
                    <div class="g-actions">
                        <form asp-action="SetThumbnail" method="post" class="m-0">
                            <input type="hidden" name="productId" value="@Model.ProductId" /><input type="hidden" name="fileName" value="@img.ImageFileName" />
                            <button class="btn btn-sm btn-outline-secondary" title="Đặt làm ảnh đại diện"><i class="bi bi-pin-angle"></i></button>
                        </form>
                        <form asp-action="DeleteImage" method="post" class="m-0" onsubmit="return confirm('Xóa ảnh này?')">
                            <input type="hidden" name="productId" value="@Model.ProductId" /><input type="hidden" name="fileName" value="@img.ImageFileName" />
                            <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            }
            @if (!Model.Images.Any()) { <span class="text-muted">Chưa có ảnh</span> }
        </div>
        <form asp-action="AddImages" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data" class="d-flex gap-2">
            <input type="file" name="files" accept="image/*" multiple class="form-control" style="max-width:420px" />
            <button class="btn btn-primary"><i class="bi bi-upload"></i> Tải lên</button>
        </form>
    </div>
</div>
