@model Product
@{
    var isEdit = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    ViewData["Title"] = (isEdit ? "Sửa " : "Thêm ") + "sản phẩm";
}

<div class="page-head">
    <h1><i class="bi bi-bag"></i> @ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data"
              action="@(isEdit ? Url.Action("Edit", new { id = Model.ProductId }) : Url.Action("Create"))">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
        @if (isEdit)
        {
            <div class="col-md-6">
                <label class="form-label">Mã sản phẩm</label>
                <input class="form-control" value="@Model.ProductId" readonly />
            </div>
        }
        <div class="col-md-6">
            <label class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
            <input asp-for="ProductName" class="form-control" />
            <span asp-validation-for="ProductName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Chất liệu</label>
            <select asp-for="MaterialId" asp-items="@(ViewBag.MaterialIdOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="MaterialId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Form dáng</label>
            <select asp-for="FitType" asp-items="@(ViewBag.FitTypeOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="FitType" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Mã kiểu (Style code)</label>
            <input asp-for="StyleCode" class="form-control" />
            <span asp-validation-for="StyleCode" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Khối lượng (kg)</label>
            <input asp-for="Weight" type="number" step="any" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Mùa</label>
            <select asp-for="Season" asp-items="@(ViewBag.SeasonOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="Season" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Thương hiệu</label>
            <select asp-for="BrandId" asp-items="@(ViewBag.BrandIdOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="BrandId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Xuất xứ</label>
            <select asp-for="OriginCountryId" asp-items="@(ViewBag.OriginCountryIdOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="OriginCountryId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Danh mục</label>
            <select asp-for="CategoryId" asp-items="@(ViewBag.CategoryIdOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Đối tượng</label>
            <select asp-for="AudienceId" asp-items="@(ViewBag.AudienceIdOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="AudienceId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Bảo hành (ngày)</label>
            <input asp-for="WarrantyDays" type="number" step="any" class="form-control" />
            <span asp-validation-for="WarrantyDays" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Giảm giá (%)</label>
            <input asp-for="DiscountPercent" type="number" step="any" class="form-control" />
            <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Website</label>
            <input asp-for="Website" class="form-control" />
            <span asp-validation-for="Website" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label class="form-label">Hướng dẫn bảo quản</label>
            <textarea asp-for="CareInstructions" rows="3" class="form-control"></textarea>
            <span asp-validation-for="CareInstructions" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label class="form-label">Mô tả</label>
            <textarea asp-for="Description" rows="3" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Ảnh đại diện</label>
            <div class="d-flex gap-3 align-items-start">
                <img src="@AdminUi.Img(Model.Thumbnail)" class="thumb-lg" alt="" id="prev_Thumbnail" onerror="this.style.opacity=0" />
                <div class="flex-grow-1">
                    <input type="file" name="Thumbnail_file" accept="image/*" class="form-control mb-2 img-input" data-preview="prev_Thumbnail" />
                    <input asp-for="Thumbnail" class="form-control" placeholder="hoặc nhập tên file ảnh có sẵn" />
                    <span asp-validation-for="Thumbnail" class="text-danger small"></span>
                </div>
            </div>
        </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
