@model Size
@{
    var isEdit = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    ViewData["Title"] = (isEdit ? "Sửa " : "Thêm ") + "kích cỡ";
}

<div class="page-head">
    <h1><i class="bi bi-rulers"></i> @ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data"
              action="@(isEdit ? Url.Action("Edit", new { id = Model.SizeId }) : Url.Action("Create"))">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Mã size <span class="text-danger">*</span></label>
            <input asp-for="SizeId" class="form-control" readonly="@isEdit" autocomplete="off" />
            <span asp-validation-for="SizeId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Mô tả size <span class="text-danger">*</span></label>
            <input asp-for="SizeName" class="form-control" />
            <span asp-validation-for="SizeName" class="text-danger small"></span>
        </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
