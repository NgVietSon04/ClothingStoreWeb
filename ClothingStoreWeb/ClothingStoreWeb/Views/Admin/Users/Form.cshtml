@model AppUser
@{
    var isEdit = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    ViewData["Title"] = (isEdit ? "Sửa " : "Thêm ") + "tài khoản";
}

<div class="page-head">
    <h1><i class="bi bi-person-lock"></i> @ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data"
              action="@(isEdit ? Url.Action("Edit", new { id = Model.Username }) : Url.Action("Create"))">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
            <input asp-for="Username" class="form-control" readonly="@isEdit" autocomplete="off" />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
            @if (isEdit)
            {
                <input type="password" name="Password" class="form-control" placeholder="Để trống nếu không đổi mật khẩu" autocomplete="new-password" />
            }
            else
            {
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label">Vai trò <span class="text-danger">*</span></label>
            <select asp-for="UserRole" asp-items="@(ViewBag.UserRoleOptions as IEnumerable<SelectListItem>)" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="UserRole" class="text-danger small"></span>
        </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
