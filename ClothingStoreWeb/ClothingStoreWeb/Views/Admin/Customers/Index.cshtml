@model PagedList<Customer>
@{
    ViewData["Title"] = "Khách hàng";
}

<div class="page-head">
    <div>
        <h1><i class="bi bi-person-heart"></i> Khách hàng</h1>
        <p class="text-muted mb-0">Tổng cộng @Model.TotalItems bản ghi</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm mới</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-5">
                <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm kiếm..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i> Tìm</button>
                @if (!string.IsNullOrEmpty((string?)ViewBag.Q))
                {
                    <a asp-action="Index" class="btn btn-link">Xóa lọc</a>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã KH</th>
                        <th>Ảnh đại diện</th>
                        <th>Họ và tên</th>
                        <th>Tài khoản đăng nhập</th>
                        <th>Số điện thoại</th>
                        <th>Loại khách</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.CustomerId</td>
                            <td><img src="@AdminUi.Img(item.Avatar)" class="thumb" alt="" onerror="this.style.opacity=0" /></td>
                            <td>@item.FullName</td>
                            <td>@AdminUi.Lk(ViewData, "UsernameOptions", item.Username)</td>
                            <td>@item.PhoneNumber</td>
                            <td>@AdminUi.Lk(ViewData, "CustomerTypeOptions", item.CustomerType)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa"
                                        data-delete-url="@Url.Action("Delete", new { id = item.CustomerId })"
                                        data-delete-name="@item.FullName"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model" />
    </div>
</div>
