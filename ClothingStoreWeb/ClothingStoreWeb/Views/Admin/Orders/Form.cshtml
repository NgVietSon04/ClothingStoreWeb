@model OrderFormVm
@{
    var isEdit = !string.IsNullOrEmpty(Model.OrderId);
    ViewData["Title"] = isEdit ? "Sửa đơn hàng " + Model.OrderId : "Tạo đơn hàng";
    var customers = (IEnumerable<SelectListItem>)ViewBag.Customers;
    var employees = (IEnumerable<SelectListItem>)ViewBag.Employees;
    var variants = (List<VariantPickVm>)ViewBag.Variants;
}
<div class="page-head">
    <h1><i class="bi bi-receipt"></i> @ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<form method="post" action="@(isEdit ? Url.Action("Edit", new { id = Model.OrderId }) : Url.Action("Create"))">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-md-4"><label class="form-label">Ngày đặt</label><input asp-for="OrderDate" type="datetime-local" value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Khách hàng</label>
            <select asp-for="CustomerId" asp-items="customers" class="form-select"><option value="">-- Khách lẻ --</option></select></div>
        <div class="col-md-4"><label class="form-label">Nhân viên</label>
            <select asp-for="EmployeeId" asp-items="employees" class="form-select"><option value="">-- Chọn --</option></select></div>
        <div class="col-md-4"><label class="form-label">Hình thức thanh toán</label>
            <select asp-for="PaymentMethod" class="form-select">
                @foreach (var p in AdminUi.PaymentMethods) { <option value="@p.Value" selected="@(Model.PaymentMethod.ToString() == p.Value)">@p.Text</option> }
            </select></div>
        <div class="col-md-4"><label class="form-label">Giảm giá đơn (%)</label><input asp-for="OrderDiscount" type="number" step="any" min="0" max="100" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Mã số thuế</label><input asp-for="TaxCode" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Thông tin thuế</label><input asp-for="TaxInfo" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Ghi chú</label><input asp-for="Notes" class="form-control" /></div>
    </div></div></div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center"><span>Sản phẩm trong đơn</span>
            <button type="button" id="btnAddRow" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i> Thêm dòng</button></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" data-mode="order">
                <thead><tr><th style="min-width:300px">Biến thể</th><th style="width:100px">SL</th><th style="width:150px">Đơn giá</th><th style="width:110px">Giảm (%)</th><th class="text-end" style="width:150px">Thành tiền</th><th style="width:50px"></th></tr></thead>
                <tbody id="itemRows">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var it = Model.Items[i];
                    <tr>
                        <td><select data-field="VariantId" name="Items[@i].VariantId" class="form-select variant-select">
                            <option value="">-- Chọn biến thể --</option>
                            @foreach (var v in variants)
                            {
                                <option value="@v.Id" data-price="@AdminUi.Num(v.Price)" data-discount="@AdminUi.Num(v.Discount)" selected="@(v.Id == it.VariantId)">@v.Text</option>
                            }
                        </select></td>
                        <td><input data-field="Quantity" name="Items[@i].Quantity" type="number" min="1" value="@it.Quantity" class="form-control qty" /></td>
                        <td><input data-field="UnitPrice" name="Items[@i].UnitPrice" type="number" min="0" step="any" value="@AdminUi.Num(it.UnitPrice)" class="form-control price" /></td>
                        <td><input data-field="Discount" name="Items[@i].Discount" type="number" min="0" max="100" step="any" value="@AdminUi.Num(it.Discount)" class="form-control disc" /></td>
                        <td class="text-end line-total">0 ₫</td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="bi bi-x-lg"></i></button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-body"><div class="totals">
            <div class="row-t"><span>Tạm tính</span><span id="sumSub">0 ₫</span></div>
            <div class="row-t grand"><span>Tổng cộng</span><span id="sumTotal">0 ₫</span></div>
        </div></div>
    </div>

    <template id="rowTemplate">
        <tr>
            <td><select data-field="VariantId" class="form-select variant-select">
                <option value="">-- Chọn biến thể --</option>
                @foreach (var v in variants) { <option value="@v.Id" data-price="@AdminUi.Num(v.Price)" data-discount="@AdminUi.Num(v.Discount)">@v.Text</option> }
            </select></td>
            <td><input data-field="Quantity" type="number" min="1" value="1" class="form-control qty" /></td>
            <td><input data-field="UnitPrice" type="number" min="0" step="any" value="0" class="form-control price" /></td>
            <td><input data-field="Discount" type="number" min="0" max="100" step="any" value="0" class="form-control disc" /></td>
            <td class="text-end line-total">0 ₫</td>
            <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="bi bi-x-lg"></i></button></td>
        </tr>
    </template>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Lưu đơn hàng</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
    <p class="text-muted small mt-2">Tồn kho sẽ tự động được trừ khi lưu (và hoàn lại khi sửa / xóa đơn).</p>
</form>
